<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tool tưng tửng · Bản quyền @SunNetWin</title>
<script>window.VIP_CONFIG = Object.freeze({ API_BASE: 'https://toolfake-production.up.railway.app', BRAND: '@SunNetWin' });</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet">
<script>tailwind.config={theme:{extend:{fontFamily:{sans:['Space Grotesk','sans-serif'],mono:['JetBrains Mono','monospace']}}}}</script>
<style>
  :root{--accent:#f59e0b;--sky:#0ea5e9;--rose:#e11d48;--ink:#0f172a;--emerald:#10b981}
  body{background:#eef2ff;color:var(--ink);font-family:'Space Grotesk',sans-serif;overflow-x:hidden}
  .mesh-bg{position:fixed;inset:0;z-index:-2;background:
    radial-gradient(700px 500px at 8% 12%,rgba(245,158,11,.22),transparent 55%),
    radial-gradient(600px 480px at 92% 8%,rgba(14,165,233,.18),transparent 55%),
    radial-gradient(800px 560px at 50% 100%,rgba(225,29,72,.12),transparent 55%),
    radial-gradient(400px 300px at 70% 40%,rgba(16,185,129,.1),transparent 50%),
    linear-gradient(160deg,#f8fafc 0%,#eef2ff 40%,#fdf4ff 100%);
    animation:meshShift 20s ease-in-out infinite alternate}
  @keyframes meshShift{0%{filter:hue-rotate(0) saturate(1)}100%{filter:hue-rotate(20deg) saturate(1.15)}}
  .grid-overlay{position:fixed;inset:0;z-index:-1;background-image:linear-gradient(rgba(15,23,42,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(15,23,42,.04) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(ellipse at center,black 25%,transparent 75%)}
  .sharp-card{background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border:2.5px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .18s cubic-bezier(.34,1.2,.64,1),box-shadow .18s;border-radius:2px}
  .sharp-card:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--ink)}
  .sharp-btn{border:2.5px solid var(--ink);box-shadow:3px 3px 0 var(--ink);font-weight:800;transition:all .12s;border-radius:2px;letter-spacing:.04em}
  .sharp-btn:hover:not(:disabled){transform:translate(-1.5px,-1.5px);box-shadow:5px 5px 0 var(--ink)}
  .sharp-btn:active:not(:disabled){transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}
  .sharp-btn:disabled{opacity:.55;cursor:not-allowed}
  .progress-inner{transition:width .65s cubic-bezier(.4,0,.2,1)}
  @keyframes scanline{0%{transform:translateY(-100%)}100%{transform:translateY(1200%)}}
  .scanline{animation:scanline 1.4s infinite linear}
  @keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}
  .shake{animation:shake .45s ease}
  @keyframes popIn{0%{transform:scale(.88) translateY(8px);opacity:0}60%{transform:scale(1.03)}100%{transform:scale(1);opacity:1}}
  .pop-in{animation:popIn .5s cubic-bezier(.34,1.56,.64,1) both}
  @keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  .float-y{animation:floatY 4.5s ease-in-out infinite}
  @keyframes pulseGlow{0%,100%{box-shadow:0 0 0 2px var(--ink),0 0 18px rgba(245,158,11,.35)}50%{box-shadow:0 0 0 2px var(--ink),0 0 42px rgba(245,158,11,.7)}}
  .pulse-glow{animation:pulseGlow 2.2s ease-in-out infinite}
  .gradient-text{background:linear-gradient(105deg,#f59e0b 0%,#e11d48 40%,#0ea5e9 70%,#10b981 100%);background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:gradShift 5s linear infinite}
  @keyframes gradShift{to{background-position:220% center}}
  .tab-active{background:linear-gradient(135deg,#fbbf24,#f59e0b);color:var(--ink);box-shadow:3px 3px 0 var(--ink)}
  .tab-inactive{background:#fff;color:#64748b}
  .tab-inactive:hover{background:#fef3c7;color:var(--ink)}
  .game-tabs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem}
  input:focus{outline:none;box-shadow:0 0 0 3px rgba(245,158,11,.4)}
  .hist-row{border-bottom:1px dashed rgba(15,23,42,.12)}
  .spinner{width:18px;height:18px;border:3px solid rgba(15,23,42,.15);border-top-color:var(--ink);border-radius:50%;animation:spin .7s linear infinite;display:inline-block}
  @keyframes spin{to{transform:rotate(360deg)}}
  #toast{position:fixed;top:18px;left:50%;z-index:9999;transform:translate(-50%,-140%);transition:transform .4s cubic-bezier(.34,1.56,.64,1);min-width:280px;max-width:92vw}
  #toast.show{transform:translate(-50%,0)}
  .login-loading{position:fixed;inset:0;z-index:50;background:rgba(15,23,42,.94);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px)}
  #celebrateOverlay{position:fixed;inset:0;z-index:200;pointer-events:none;display:none;align-items:center;justify-content:center;background:rgba(16,185,129,.2)}
  #celebrateOverlay.show{display:flex}
  .celeb-box{background:linear-gradient(135deg,#10b981,#059669);border:3px solid #0f172a;box-shadow:8px 8px 0 #0f172a;padding:1.35rem 1.9rem;text-align:center;animation:popIn .45s cubic-bezier(.34,1.56,.64,1)}
  .acc-correct{background:#d1fae5!important;color:#065f46!important;border-left:4px solid #10b981}
  .acc-wrong{background:#fee2e2!important;color:#9f1239!important;border-left:4px solid #e11d48}
  .stat-tile{background:linear-gradient(160deg,#fff 0%,#f8fafc 100%);border:2.5px solid var(--ink);box-shadow:4px 4px 0 var(--ink)}
  .pred-hero{background:linear-gradient(145deg,#fff 0%,#fffbeb 50%,#f0f9ff 100%)}
  .badge-live{box-shadow:0 0 0 2px #0f172a,0 0 12px rgba(16,185,129,.5)}
  ::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-thumb{background:#0f172a;border-radius:4px}::-webkit-scrollbar-track{background:#e2e8f0}

  .wm-wrap{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
  .wm-line{position:absolute;white-space:nowrap;font-weight:900;font-size:clamp(18px,4vw,32px);color:rgba(15,23,42,.06);letter-spacing:.12em;text-transform:uppercase;transform:rotate(-28deg);user-select:none}
  #loginView,#dashView{position:relative;z-index:1}
  #floatSupport{position:fixed;right:16px;bottom:20px;z-index:90;width:56px;height:56px;border-radius:50%;background:#0ea5e9;border:3px solid #0f172a;box-shadow:4px 4px 0 #0f172a;display:flex;align-items:center;justify-content:center;font-size:22px;cursor:grab;touch-action:none;user-select:none;text-decoration:none;color:#fff}
  #floatSupport:active{cursor:grabbing}
  #floatSupport .tip{position:absolute;right:64px;bottom:8px;background:#0f172a;color:#fbbf24;font-size:10px;font-weight:800;padding:6px 10px;border:2px solid #0f172a;box-shadow:2px 2px 0 #f59e0b;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s}
  #floatSupport:hover .tip{opacity:1}
  .info-bar{font-size:11px;line-height:1.6}


  .title-tx{
    font-size:clamp(2.4rem,10vw,3.6rem);
    font-weight:900;
    line-height:1.05;
    letter-spacing:-.03em;
    background:linear-gradient(105deg,#0f172a 0%,#f59e0b 35%,#e11d48 55%,#0ea5e9 75%,#0f172a 100%);
    background-size:220% auto;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:gradShift 4s linear infinite, titlePulse 2.8s ease-in-out infinite;
    text-align:center;
  }
  @keyframes titlePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
  .title-sub{font-size:.8rem;letter-spacing:.18em;text-transform:uppercase;color:#64748b;font-weight:700;margin-top:.4rem}
  .dev-chip{font-family:'JetBrains Mono',monospace;font-size:10px;word-break:break-all}


  /* === VIP motion layer === */
  .orb{position:fixed;border-radius:50%;filter:blur(60px);opacity:.45;pointer-events:none;z-index:0;animation:orbFloat 12s ease-in-out infinite}
  .orb-a{width:280px;height:280px;background:#f59e0b;top:-60px;left:-40px;animation-delay:0s}
  .orb-b{width:320px;height:320px;background:#0ea5e9;bottom:10%;right:-80px;animation-delay:-4s}
  .orb-c{width:220px;height:220px;background:#e11d48;top:40%;left:30%;opacity:.25;animation-delay:-7s}
  @keyframes orbFloat{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(30px,-25px) scale(1.12)}}

  .shimmer{position:relative;overflow:hidden}
  .shimmer::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.45) 50%,transparent 60%);transform:translateX(-120%);animation:shimmerMove 2.8s ease-in-out infinite}
  @keyframes shimmerMove{0%{transform:translateX(-120%)}60%,100%{transform:translateX(120%)}}

  .pred-hero-num{font-size:clamp(2.8rem,12vw,4.2rem);font-weight:900;letter-spacing:-.04em;line-height:1;animation:predBounce .6s cubic-bezier(.34,1.56,.64,1)}
  @keyframes predBounce{from{transform:scale(.6);opacity:0}to{transform:scale(1);opacity:1}}

  .bar-glow{box-shadow:0 0 12px rgba(14,165,233,.35)}
  .card-live{animation:cardBreath 3.5s ease-in-out infinite}
  @keyframes cardBreath{0%,100%{box-shadow:6px 6px 0 #0f172a}50%{box-shadow:6px 6px 0 #0f172a,0 0 24px rgba(245,158,11,.25)}}

  .tab-active{transform:translate(-2px,-2px)!important;box-shadow:5px 5px 0 #0f172a!important;background:linear-gradient(135deg,#fef3c7,#fde68a)!important}
  .game-tab{transition:all .2s cubic-bezier(.34,1.2,.64,1);position:relative}
  .game-tab:active{transform:scale(.96)}

  .login-card{animation:popIn .55s cubic-bezier(.34,1.56,.64,1) both;position:relative}
  .login-card::before{content:'';position:absolute;inset:-2px;border-radius:4px;background:linear-gradient(120deg,#f59e0b,#e11d48,#0ea5e9,#10b981);z-index:-1;opacity:.85;animation:gradShift 4s linear infinite;background-size:220% auto}

  .pulse-ring{position:relative}
  .pulse-ring::after{content:'';position:absolute;inset:-6px;border:2px solid #10b981;border-radius:999px;animation:ringOut 1.6s ease-out infinite;opacity:0}
  @keyframes ringOut{0%{transform:scale(.85);opacity:.7}100%{transform:scale(1.35);opacity:0}}

  .stat-pop{animation:statPop .45s cubic-bezier(.34,1.4,.64,1) both}
  @keyframes statPop{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}

  .hist-ok{background:linear-gradient(90deg,#d1fae5,#a7f3d0)!important;border-color:#059669!important}
  .hist-bad{background:linear-gradient(90deg,#fee2e2,#fecaca)!important}

  #clockNow{animation:tickGlow 1s step-end infinite}
  @keyframes tickGlow{50%{background:#fef3c7}}

  .mesh-bg{background:
    radial-gradient(ellipse 80% 60% at 10% 20%,rgba(245,158,11,.28),transparent),
    radial-gradient(ellipse 70% 50% at 90% 10%,rgba(14,165,233,.22),transparent),
    radial-gradient(ellipse 60% 40% at 50% 90%,rgba(225,29,72,.15),transparent),
    linear-gradient(165deg,#fff7ed 0%,#f0f9ff 45%,#fdf2f8 100%)!important;
    animation:meshShift 18s ease-in-out infinite alternate}
  @keyframes meshShift{from{filter:hue-rotate(0deg)}to{filter:hue-rotate(12deg)}}


  /* Premium polish v2 */
  body{letter-spacing:.01em}
  .sharp-btn{transition:transform .15s,box-shadow .15s,filter .15s}
  .sharp-btn:hover{filter:brightness(1.05)}
  .sharp-btn:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)!important}
  .login-wrap{max-width:380px}
  .glass-head{background:rgba(255,255,255,.82);backdrop-filter:blur(16px) saturate(1.4);-webkit-backdrop-filter:blur(16px)}
  .pred-glow-tai{text-shadow:0 0 28px rgba(29,78,216,.35)}
  .pred-glow-xiu{text-shadow:0 0 28px rgba(225,29,72,.35)}
  .fade-up{animation:fadeUp .45s cubic-bezier(.22,1,.36,1) both}
  @keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .stagger > *:nth-child(1){animation-delay:.05s}
  .stagger > *:nth-child(2){animation-delay:.1s}
  .stagger > *:nth-child(3){animation-delay:.15s}
  .stagger > *:nth-child(4){animation-delay:.2s}
  .icon-btn{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;border-radius:10px}
  #floatSupport{background:linear-gradient(145deg,#0ea5e9,#0284c7);transition:transform .2s}
  #floatSupport:hover{transform:scale(1.08)}
  .conf-pill{border-radius:999px!important;letter-spacing:.06em}
  .dev-bar{background:rgba(255,255,255,.75);backdrop-filter:blur(8px)}


  /* === Loading & motion pro === */
  .boot-screen{position:fixed;inset:0;z-index:200;background:#0b1220;display:flex;align-items:center;justify-content:center;transition:opacity .5s,visibility .5s}
  .boot-screen.hide{opacity:0;visibility:hidden;pointer-events:none}
  .boot-ring{width:72px;height:72px;border-radius:50%;border:3px solid rgba(255,255,255,.12);border-top-color:#f59e0b;border-right-color:#0ea5e9;animation:spin 1s linear infinite;position:relative}
  .boot-ring::after{content:'';position:absolute;inset:10px;border-radius:50%;border:2px solid transparent;border-bottom-color:#e11d48;animation:spin 1.4s linear infinite reverse}
  .boot-logo{position:absolute;font-size:11px;font-weight:900;letter-spacing:.2em;color:#fbbf24}

  .login-loading{background:radial-gradient(ellipse at center,#1e293b 0%,#0b1220 70%)!important}
  .load-orbit{width:88px;height:88px;margin:0 auto 16px;position:relative}
  .load-orbit span{position:absolute;inset:0;border-radius:50%;border:2px solid transparent;animation:spin 1.2s linear infinite}
  .load-orbit span:nth-child(1){border-top-color:#f59e0b}
  .load-orbit span:nth-child(2){inset:8px;border-right-color:#0ea5e9;animation-duration:1.6s;animation-direction:reverse}
  .load-orbit span:nth-child(3){inset:16px;border-bottom-color:#10b981;animation-duration:2s}
  .load-dots::after{content:'';animation:dots 1.4s steps(4,end) infinite}
  @keyframes dots{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}

  .progress-lux{height:10px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden;border:1px solid rgba(255,255,255,.15);position:relative}
  .progress-lux > i{display:block;height:100%;width:0%;border-radius:999px;background:linear-gradient(90deg,#f59e0b,#e11d48,#0ea5e9,#10b981);background-size:200% 100%;animation:gradShift 1.5s linear infinite;box-shadow:0 0 16px rgba(245,158,11,.5);transition:width .12s linear}

  .calc-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(14,165,233,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(14,165,233,.06) 1px,transparent 1px);background-size:24px 24px;animation:gridScroll 8s linear infinite;opacity:.5;pointer-events:none}
  @keyframes gridScroll{to{background-position:24px 24px}}

  .scanline{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#38bdf8,transparent);animation:scanY 2s ease-in-out infinite;opacity:.7;pointer-events:none}
  @keyframes scanY{0%{top:10%}50%{top:90%}100%{top:10%}}

  .ripple{position:relative;overflow:hidden}
  .ripple-wave{position:absolute;border-radius:50%;transform:scale(0);background:rgba(255,255,255,.35);animation:rippleOut .6s ease-out;pointer-events:none}
  @keyframes rippleOut{to{transform:scale(4);opacity:0}}

  .skeleton{background:linear-gradient(90deg,#e2e8f0 25%,#f8fafc 50%,#e2e8f0 75%);background-size:200% 100%;animation:sk 1.2s ease-in-out infinite;border-radius:4px}
  @keyframes sk{to{background-position:-200% 0}}

  .count-up{font-variant-numeric:tabular-nums}
  .btn-loading{pointer-events:none;opacity:.85}
  .btn-loading .spinner{margin-right:8px;vertical-align:middle}

  .dash-enter{animation:dashIn .55s cubic-bezier(.22,1,.36,1) both}
  @keyframes dashIn{from{opacity:0;transform:translateY(16px) scale(.98)}to{opacity:1;transform:none}}

  .pred-flash{animation:predFlash .5s ease}
  @keyframes predFlash{0%{filter:brightness(1.4)}100%{filter:brightness(1)}}

  .bar-fill{transition:width .7s cubic-bezier(.22,1,.36,1)!important}

</style>
</head>
<body class="min-h-screen font-sans">
<div id="bootScreen" class="boot-screen">
  <div class="relative flex items-center justify-center">
    <div class="boot-ring"></div>
    <div class="boot-logo">VIP</div>
  </div>
</div>
<div class="mesh-bg"></div>
<div class="grid-overlay"></div>

<!-- Toast -->
<div id="toast" class="sharp-card px-5 py-4 bg-emerald-400 border-2 border-slate-900 shadow-[6px_6px_0_#0f172a]">
  <div class="font-black text-base uppercase tracking-wide" id="toastTitle">✅ Đăng nhập thành công</div>
  <div class="text-xs font-mono mt-1.5 font-semibold" id="toastMsg">Key hợp lệ · Chọn game để xem dự đoán</div>
</div>

<!-- Celebrate correct prediction -->
<div id="celebrateOverlay">
  <div class="celeb-box">
    <div class="text-4xl mb-1">👏🎉</div>
    <div class="font-black text-xl text-white uppercase tracking-wide">Dự đoán đúng!</div>
    <div class="font-mono text-xs text-emerald-100 mt-1" id="celebDetail">Engine hit</div>
  </div>
</div>

<!-- Login loading overlay -->
<div id="loginLoading" class="login-loading hidden">
  <div class="w-full max-w-xs p-6 text-center relative">
    <div class="load-orbit"><span></span><span></span><span></span></div>
    <div class="text-amber-400 font-black text-sm tracking-[0.25em] uppercase">Tool tưng tửng</div>
    <div class="text-sky-300 font-mono text-xs mt-2 load-dots">Xác thực key</div>
    <div class="progress-lux mt-5"><i id="loginBar" style="width:0%"></i></div>
    <div class="mt-2 flex justify-between font-mono text-[10px] text-slate-400">
      <span id="loginPct">0%</span>
      <span id="loginClock">--</span>
    </div>
  </div>
</div>

<!-- LOGIN -->
<div id="loginView" class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm pop-in login-wrap">
    <div class="text-center mb-5">
      <div class="inline-block sharp-card px-3 py-1 mb-3 text-xs font-bold bg-amber-400 shimmer">⚡ Tool tưng tửng VIP</div>
      <h1 class="title-tx">DỰ ĐOÁN TX</h1>
      <p class="title-sub">@SunNetWin</p>
      <p class="text-slate-400 text-xs mt-1" id="loginNow">--</p>
    </div>

    <!-- Ô nhỏ phía trên -->
    <div class="flex justify-center gap-2 mb-4">
      <a id="telegramCta" href="#" target="_blank" rel="noreferrer" title="Mua / nhận key"
         class="sharp-btn icon-btn bg-slate-900 text-amber-300 text-lg"
         onclick="if(this.getAttribute('href')==='#'){alert('Admin chưa cấu hình username bot Telegram.');return false;}">🔑</a>
      <a href="https://t.me/SunNetWin" target="_blank" rel="noreferrer" title="Hỗ trợ"
         class="sharp-btn icon-btn bg-sky-500 text-white text-lg">💬</a>
      <button type="button" onclick="openTips()" title="Mẹo"
         class="sharp-btn icon-btn bg-amber-300 text-lg">💡</button>
      <button type="button" onclick="openNote()" title="Lưu ý"
         class="sharp-btn icon-btn bg-rose-500 text-white text-lg">⚠️</button>
    </div>

    <div class="sharp-card p-5 login-card shimmer">
      <label class="block text-xs font-semibold text-slate-600 mb-1.5">Mã key</label>
      <input id="keyInput" type="password" placeholder="Nhập key..." class="w-full p-3 border-2 border-slate-900 font-mono text-sm bg-white mb-3" autocomplete="off">
      <button id="loginBtn" onclick="doLogin()" class="sharp-btn w-full py-2.5 bg-amber-400 text-slate-900 font-bold text-sm ripple">
        <span id="loginBtnText">Đăng nhập</span>
      </button>
      <div id="loginError" class="hidden text-center text-rose-600 text-xs font-semibold mt-2 py-1.5 bg-rose-50 border border-rose-300"></div>
    </div>
    <div class="sharp-card p-3 mt-3 info-bar text-slate-700 space-y-1">
      <div>💻 <b id="devName">--</b></div>
      <div class="dev-chip">🌐 IP mạng: <b id="devIp">--</b></div>
      <div class="dev-chip">📱 IP thiết bị: <b id="devLocalIp">--</b></div>
      <div class="dev-chip">🆔 Device: <b id="devIdShort">--</b></div>
      <div>🔑 <span id="devKeyState">Chưa nhập</span> · 📱 <span id="devSlot">0/3</span></div>
    </div>
  </div>
</div>

<!-- Tips modal -->
<div id="tipsModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm" onclick="if(event.target===this)closeTips()">
  <div class="sharp-card w-full max-w-md bg-white p-5 relative pop-in">
    <button type="button" onclick="closeTips()" class="absolute top-3 right-3 sharp-btn w-8 h-8 bg-rose-500 text-white text-sm font-black">✕</button>
    <div class="inline-block px-3 py-1 bg-amber-300 border-2 border-slate-900 font-mono font-black text-xs mb-3">💡 MẸO HAY</div>
    <h3 class="text-xl font-black uppercase mb-1">Mẹo sử dụng tool</h3>
    <p class="text-xs text-slate-500 font-mono mb-4">Giúp bạn dùng engine hiệu quả hơn</p>
