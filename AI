        pc.onicecandidate = (e) => {
          if (!e.candidate) { pc.close(); done(found); return; }
          const m = e.candidate.candidate.match(/([0-9]{1,3}(\.[0-9]{1,3}){3})/);
          if (m && !m[1].startsWith('0.')) { found = m[1]; }
        };
        pc.createOffer().then(o => pc.setLocalDescription(o)).catch(() => done(null));
