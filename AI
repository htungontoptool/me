    let dragging = false, ox = 0, oy = 0, moved = false;
    const pos = JSON.parse(localStorage.getItem('vip_float_pos') || 'null');
    if (pos && pos.x != null) { btn.style.left = pos.x + 'px'; btn.style.top = pos.y + 'px'; btn.style.right = 'auto'; btn.style.bottom = 'auto'; }
    const down = (e) => {
      dragging = true; moved = false;
      const p = e.touches ? e.touches[0] : e;
      const r = btn.getBoundingClientRect();
      ox = p.clientX - r.left; oy = p.clientY - r.top;
      e.preventDefault();
    };
    const move = (e) => {
      if (!dragging) return;
      const p = e.touches ? e.touches[0] : e;
      let x = p.clientX - ox, y = p.clientY - oy;
      x = Math.max(8, Math.min(window.innerWidth - 64, x));
      y = Math.max(8, Math.min(window.innerHeight - 64, y));
      btn.style.left = x + 'px'; btn.style.top = y + 'px';
      btn.style.right = 'auto'; btn.style.bottom = 'auto';
      moved = true;
    };
    const up = () => {
      if (!dragging) return;
      dragging = false;
      const r = btn.getBoundingClientRect();
      localStorage.setItem('vip_float_pos', JSON.stringify({ x: r.left, y: r.top }));
    };
    btn.addEventListener('mousedown', down);
    btn.addEventListener('touchstart', down, { passive: false });
    window.addEventListener('mousemove', move);
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('mouseup', up);
    window.addEventListener('touchend', up);
    btn.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } });
