    set('devKeyState', loadSession() ? 'Đã lưu key' : 'Chưa nhập');
    try {
      const r = await fetch('https://api.ipify.org?format=json');
      const d = await r.json();
      const net = d.ip || '—';
      set('devIp', net); set('dashDevIp', net);
    } catch {
      set('devIp', '—'); set('dashDevIp', '—');
    }
    const local = await getLocalIp();
    set('devLocalIp', local); set('dashLocalIp', local);
  }

  async function loadPublicConfig(){
    try {
      const r = await fetch(apiBase + '/api/public/config');
      const d = await r.json();
      if (d.telegramUrl && $('telegramCta')) $('telegramCta').href = d.telegramUrl;
      const support = d.supportUrl || d.telegramUrl || 'https://t.me/SunNetWin';
      initFloatSupport(support);
      buildWatermark(d.watermarkText || (d.games || []).join(' · ') || 'Tool tưng tửng');
      if (d.siteTitle) document.title = d.siteTitle + ' · @SunNetWin';
    } catch(e){
      buildWatermark('Tool tưng tửng');
      initFloatSupport('https://t.me/SunNetWin');
    }
  }

  function renderGameTabs(){
    const root = $('gameTabs');
    if (!gamesList.length){ root.innerHTML = '<div class="sharp-card p-4 text-center text-slate-500">Chưa có game.</div>'; return; }
    const n = gamesList.length;
    if (n === 1) root.style.gridTemplateColumns = '1fr';
    else if (n === 2) root.style.gridTemplateColumns = 'repeat(2, 1fr)';
    else if (n === 3) root.style.gridTemplateColumns = 'repeat(3, 1fr)';
    else root.style.gridTemplateColumns = 'repeat(auto-fit, minmax(140px, 1fr))';
    root.innerHTML = gamesList.map(g =>
      `<button type="button" onclick="switchGame('${g.id}')" class="sharp-btn py-3 px-2 text-xs md:text-sm font-bold uppercase tracking-wide ${g.id===currentGame?'tab-active':'tab-inactive'}">${escHtml(g.label)}</button>`
    ).join('');
  }

  function showGamePanels(show){
    const panels = $('gamePanels');
    const hint = $('pickGameHint');
    if (show) {
      panels.classList.remove('hidden');
      if (hint) hint.classList.add('hidden');
    } else {
      panels.classList.add('hidden');
      if (hint) hint.classList.remove('hidden');
    }
  }

  async function loadGames(){
    const d = await apiGet('/api/games');
    gamesList = d.games || [];
    renderGameTabs();
  }

  function updateKeyStatus(){
    const s = loadSession() || {};
    const label = s.label || 'KEY VIP';
    let line = '🔑 ' + label;
    if (s.expiresAt) {
      const d = new Date(Number(s.expiresAt));
      line += ' · ⏳ ' + d.toLocaleString('vi-VN');
    } else {
      line += ' · ⏳ Không hết hạn';
    }
    if ($('keyStatusLine')) $('keyStatusLine').textContent = line;
  }

  function runLoginLoading(done){
    const ov = $('loginLoading');
    ov.classList.remove('hidden');
    let p = 0;
    const t = setInterval(() => {
      p += 5;
      $('loginBar').style.width = Math.min(p, 100) + '%';
      $('loginPct').textContent = Math.min(p, 100) + '%';
      if (p >= 100) {
        clearInterval(t);
        setTimeout(() => { ov.classList.add('hidden'); done && done(); }, 200);
      }
    }, 28);
  }

  window.doLogin = async function(){
    const btn = $('loginBtn'), txt = $('loginBtnText'), err = $('loginError');
    const key = $('keyInput').value.trim();
    if (!key) { showErr('Vui lòng nhập mã key VIP'); return; }
    btn.disabled = true; txt.innerHTML = '<span class="spinner"></span> ĐANG XÁC THỰC...';
    err.classList.add('hidden');
    try {
      const r = await fetch(apiBase + '/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key, deviceId: deviceId() })
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Lỗi kết nối');
      saveSession({ token: d.token, label: d.label || 'KEY VIP', expiresAt: d.expiresAt || null });
      runLoginLoading(() => {
        $('loginView').classList.add('hidden');
        $('dashView').classList.remove('hidden'); $('dashView').classList.add('dash-enter');
        updateKeyStatus();
        const exp = d.expiresAt ? new Date(d.expiresAt).toLocaleString('vi-VN') : 'Không hết hạn';
        showToast('✅ Đăng nhập thành công', (d.label || 'KEY VIP') + ' · Hạn: ' + exp + ' · Chọn game để xem dự đoán');
        startDashboard();
        // Hiện Lưu ý + Mẹo ngay sau login
        setTimeout(() => maybeAutoTipsNotes(true), 600);
      });
    } catch(e) {
      showErr(e.message);
      btn.classList.add('shake'); setTimeout(() => btn.classList.remove('shake'), 500);
      btn.disabled = false; txt.textContent = 'Đăng nhập';
    }
  };

  function showErr(msg){ const e=$('loginError'); e.textContent='! '+msg; e.classList.remove('hidden'); }

  // Soft re-auth fail: clear session and show login (no logout button)
  function forceRelogin(msg){
    clearSession();
    clearInterval(refreshTimer);
    $('dashView').classList.add('hidden');
    $('loginView').classList.remove('hidden');
    if (msg) showErr(msg);
  }

  window.switchGame = function(g){
    if (currentGame === g) {
      // bấm lại game đang chọn → vẫn refresh
      fetchPrediction(true);
      return;
    }
    currentGame = g;
    renderGameTabs();
    showGamePanels(true);
    clearInterval(refreshTimer);
    fetchPrediction(true);
    refreshTimer = setInterval(() => fetchPrediction(false), 8000);
  };

  async function apiGet(path){
    const r = await fetch(apiBase + path, { headers: { 'Authorization': 'Bearer ' + token } });
    if (r.status === 401) { forceRelogin('Phiên hết hạn, nhập lại key'); throw new Error('401'); }
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  }

  function runCalcAnim(cb){
    const ov = $('calcOverlay'); ov.classList.remove('hidden');
    let p = 0;
    clearInterval(calcTimer);
    calcTimer = setInterval(() => {
      p += 4;
      $('calcBar').style.width = Math.min(p, 100) + '%';
      $('calcPct').textContent = Math.min(p, 100) + '%';
      if (p >= 100) {
        clearInterval(calcTimer);
        setTimeout(() => { ov.classList.add('hidden'); Promise.resolve().then(() => cb && cb()).catch(e => console.warn(e)); }, 150);
      }
    }, 22);
  }

  window.fetchPrediction = async function(withAnim){
    if (!token || !currentGame) return;
    try {
      const doRender = async () => {
        const [pred, hist] = await Promise.all([
          apiGet('/api/predict?game=' + encodeURIComponent(currentGame)),
          apiGet('/api/history?game=' + encodeURIComponent(currentGame) + '&limit=30&accLimit=30')
        ]);
        renderPred(pred);
        renderHistory(hist.history);
        renderAccuracy(hist.accuracyHistory, hist.accuracy);
        if (pred.feedError) {
          $('connBadge').innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-500"></span> API LỖI';
          $('connBadge').className = 'inline-flex items-center gap-1.5 px-2.5 py-1 bg-rose-50 border border-rose-600 text-rose-800 text-xs font-mono font-bold';
        } else {
          $('connBadge').innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> LIVE';
          $('connBadge').className = 'inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 border border-emerald-600 text-emerald-800 text-xs font-mono font-bold';
        }
      };
      if (withAnim) runCalcAnim(doRender); else await doRender();
    } catch(e){ console.warn(e); }
  };

  function renderPred(p){
    $('predSession').textContent = 'PHIÊN #' + (p.nextSession || '--');
    const pr = String(p.predictedResult || '').toUpperCase();
    const isBac = p.gameType === 'baccarat' || pr === 'BANKER' || pr === 'PLAYER' || pr === 'CAI' || pr === 'CON';
    const isTai = pr === 'TÀI' || pr === 'TAI' || pr === 'BANKER' || pr === 'B' || pr === 'CAI';
    const label = isBac
      ? (isTai ? 'BANKER' : 'PLAYER')
      : (isTai ? 'TÀI' : 'XỈU');
    $('predText').textContent = label;
    $('predText').className = 'pred-hero-num pred-flash ' + (isTai ? 'text-blue-700 pred-glow-tai' : 'text-rose-600 pred-glow-xiu');
    if ($('sideALabel')) $('sideALabel').textContent = isBac ? 'BANKER (B)' : 'TÀI (T)';
    if ($('sideBLabel')) $('sideBLabel').textContent = isBac ? 'PLAYER (P)' : 'XỈU (X)';
    // restart bounce
    void $('predText').offsetWidth;
    $('predText').classList.add('pred-hero-num');
    $('confTag').textContent = 'Độ Tin Cậy: 0%';
    animateNumber($('confTag'), p.confidence, '%');
    // fix label
    setTimeout(() => { if ($('confTag')) $('confTag').textContent = 'Độ Tin Cậy: ' + p.confidence + '%'; }, 400);
    $('confTag').className = 'conf-pill inline-block mt-3 px-4 py-1.5 text-xs font-mono font-extrabold border-2 border-slate-900 uppercase shimmer ' + (isTai?'bg-blue-100 text-blue-900':'bg-rose-100 text-rose-900');
    if ($('taiBar')) { $('taiBar').classList.add('bar-glow'); $('xiuBar').classList.add('bar-glow'); }
    if ($('predCard')) {
      $('predCard').style.borderLeftColor = isTai ? '#1d4ed8' : '#e11d48';
    }
    $('reasonText').textContent = p.feedError ? ('API: ' + p.feedError) : ('Lý Do: ' + p.topReason);
    $('taiPct').textContent = p.taiProb+'%'; $('xiuPct').textContent = p.xiuProb+'%';
    $('taiBar').style.width = p.taiProb+'%'; $('xiuBar').style.width = p.xiuProb+'%';
    $('mRegime').textContent = p.regime || '--';
    $('mTrend').textContent = p.trend || '--';
    $('mModels').textContent = p.activeModels;
    $('mAcc').textContent = p.accuracy ? p.accuracy.pct+'%' : '--';
    if (p.live){
      $('liveSession').textContent = '#' + p.live.session;
      $('liveDice').textContent = '[' + (p.live.dice||[]).join('-') + ']';
      $('liveSum').textContent = p.live.sum + ' nút';
      const lr = $('liveResult'); lr.textContent = p.live.char==='T'?'TÀI':'XỈU';
      lr.className = 'font-mono font-black text-lg ' + (p.live.char==='T'?'text-blue-700':'text-rose-600');
    }
  }

  function renderHistory(list){
    $('histCount').textContent = (list?.length || 0) + ' phiên';
    if (!list || !list.length){ $('histList').innerHTML = '<div class="text-center py-4 text-slate-400">Chưa có dữ liệu</div>'; return; }
    $('histList').innerHTML = list.map(h => `
      <div class="hist-row flex items-center justify-between py-1.5 px-2 hover:bg-amber-50">
        <span class="font-bold text-slate-700">#${escHtml(h.session)}</span>
        <span class="text-slate-500">[${escHtml((h.dice||[]).join('-'))}] = ${escHtml(h.sum)} nút</span>
        <span class="font-black ${h.char==='T'?'text-blue-700':'text-rose-600'}">${h.char==='T'?'TÀI':'XỈU'}</span>
      </div>`).join('');
  }

  function renderAccuracy(list, summary){
    if (summary) {
      $('accSummary').textContent = `✅ ${summary.correct}/${summary.total} · ${summary.pct}%`;
    } else {
      $('accSummary').textContent = '--';
    }
    if (!list || !list.length) {
      $('accList').innerHTML = '<div class="text-center py-4 text-slate-400">Chưa có lịch sử dự đoán</div>';
      return;
    }
    // Chỉ mừng khi có phiên đúng MỚI hơn lần đã lưu (tránh spam khi load lại)
    const newest = list.find(a => a.isCorrect === true && !a.skipped);
    if (newest) {
      const sid = String(newest.session);
      if (!lastCelebratedSession) {
        // lần đầu load lịch sử — ghi nhận, không kêu
        lastCelebratedSession = sid;
        sessionStorage.setItem('vip_celeb_session', sid);
      } else if (sid !== String(lastCelebratedSession)) {
        lastCelebratedSession = sid;
        sessionStorage.setItem('vip_celeb_session', sid);
        const pred = newest.predicted === 'T' ? 'TÀI' : 'XỈU';
        celebrateCorrect(`Phiên #${newest.session} · Đoán ${pred} ✓`);
        showToast('✅ Dự đoán đúng!', `Phiên #${newest.session} · ${pred} · 👏`);
      }
    }
    $('accList').innerHTML = list.map(a => {
      const ok = a.isCorrect === true;
      const skip = a.skipped || a.isCorrect === null;
      const icon = skip ? '⏭️' : (ok ? '✅' : '❌');
      const cls = skip ? 'text-slate-500' : (ok ? 'acc-correct font-bold' : 'acc-wrong');
      const pred = a.predicted === 'T' || a.predicted === 'B' ? (a.predicted === 'B' ? 'BANKER' : 'TÀI') : (a.predicted === 'P' ? 'PLAYER' : 'XỈU');
      const act = a.actual === 'T' ? 'TÀI' : a.actual === 'X' ? 'XỈU' : a.actual === 'B' ? 'BANKER' : a.actual === 'P' ? 'PLAYER' : '--';
      return `<div class="hist-row flex items-center justify-between py-2 px-2 ${cls}">
        <span class="font-black">${icon} #${escHtml(a.session)}</span>
        <span>Đoán: <b>${pred}</b></span>
        <span>Ra: <b>${act}</b>${ok ? ' <span class="text-emerald-600">✓</span>' : ''}</span>
      </div>`;
    }).join('');
  }

  async function startDashboard(){
    try {
      currentGame = null;
      clearInterval(refreshTimer);
      refreshTimer = null;
      showGamePanels(false);
      await loadGames();
      updateKeyStatus();
      if ($('devKeyState')) $('devKeyState').textContent = 'Đã đăng nhập';
      fillDeviceInfo();
      // không tự load dự đoán — chờ user bấm chọn game
    } catch(e){ console.warn(e); }
  }

  // clocks
  tickClock();
  clockTimer = setInterval(tickClock, 1000);
  loadPublicConfig();
  fillDeviceInfo();

  // Auto resume if key saved within 1 day
  const saved = loadSession();
  if (saved && saved.token) {
    token = saved.token;
    $('loginView').classList.add('hidden');
    $('dashView').classList.remove('hidden'); $('dashView').classList.add('dash-enter');
    updateKeyStatus();
    startDashboard();
  }

  // Enter key to login
  $('keyInput').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
})();
</script>
</body>
</html>
